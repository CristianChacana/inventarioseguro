# Puerto del servidor
PORT=3000

# Correo Gmail del Administrador Principal (siempre tendrá acceso de administrador)
ADMIN_EMAIL=tu_correo_administrador@gmail.com

# Clave secreta para firmar las cookies de sesión en el servidor (cámbiala por una cadena larga y aleatoria en producción)
SESSION_SECRET=reemplazar_con_una_clave_secreta_de_64_caracteres_muy_segura_987654321

# Credenciales de Google OAuth 2.0 (obtener en https://console.cloud.google.com/apis/credentials)
# IMPORTANTE: El Client Secret solo vive en el backend y nunca se expone al navegador
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Clave API de Google Gemini (Opcional: solo en backend para analizar fotos difíciles o borrosas de códigos/productos)
GEMINI_API_KEY=

# Solo para pruebas locales sin configurar Google Cloud aún (cambiar a false siempre en la nube/producción)
ALLOW_DEMO_LOGIN=false
